{
  "name": "roofing-business-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de negocio para roofing: sitio web, aplicación y API.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "demo:preparar": "node scripts/demo.mjs --solo-preparar",
    "dev": "pnpm build:shared && pnpm --parallel --filter \"./apps/*\" run dev",
    "build:shared": "pnpm --filter @roofing/shared build",
    "build": "pnpm build:shared && pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck && tsc --noEmit",
    "test": "pnpm build:shared && pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:capturas": "playwright test -c playwright.capturas.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@roofing/config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3"
  }
}
