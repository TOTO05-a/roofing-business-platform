---
import { RoofVisualizer } from '@roofing/ui/visualizer';
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const v = getDict(locale).visualizer;
---

<section id="techos" class="scroll-mt-20 py-20 text-white sm:py-28" aria-labelledby="techos-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl" data-fade>
      <h2 id="techos-title" class="cine-after-title">
        {v.title}
      </h2>
      <p class="mt-4 text-lg text-on-brand-muted">{v.intro}</p>
    </div>
    <div
      class="mt-10 overflow-hidden rounded-xl bg-surface p-4 text-fg ring-1 ring-white/25 sm:mt-12 sm:p-6"
      data-fade
    >
      <RoofVisualizer
        client:visible={{ rootMargin: '300px' }}
        locale={locale}
        labels={v}
        ctaHref={`/${locale}/#contacto`}
      />
    </div>
  </div>
</section>
