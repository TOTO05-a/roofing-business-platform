---
import { Contrast } from '@lucide/astro';
import { getDict, type Locale } from '../i18n/ui';

const { locale } = Astro.props as { locale: Locale };
const t = getDict(locale);
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label={t.common.themeDark}
  title={t.common.themeDark}
  class="inline-flex size-11 items-center justify-center rounded-md text-on-brand hover:bg-white/15"
>
  <Contrast aria-hidden="true" class="size-5" />
</button>

<script>
  import { THEME_KEY, isDark, setTheme } from '../lib/theme';
  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
      sync();
      btn.onclick = () => {
        setTheme(isDark() ? 'light' : 'dark');
        sync();
      };
    });
  }
  void THEME_KEY;
  document.addEventListener('astro:page-load', init);
</script>
