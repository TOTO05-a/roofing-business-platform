---
interface Props {
  variant?: 'horizontal' | 'compact' | 'icon';
  label?: string;
  class?: string;
}
const { variant = 'horizontal', label = 'Cresta Roofing', class: className = '' } = Astro.props;
---

<span role="img" aria-label={label} class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    viewBox="0 0 48 48"
    fill="none"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    class:list={['shrink-0', variant === 'icon' ? 'size-10' : 'size-9']}
  >
    <path d="M5 27 24 10l19 17" stroke="currentColor"></path>
    <path d="M13 38l11-10 11 10" stroke="var(--ring-on-brand, #f4b27a)"></path>
  </svg>
  {variant !== 'icon' && (
    <span aria-hidden="true" class="flex flex-col leading-none">
      <span class="font-display text-xl font-extrabold tracking-tight">Cresta</span>
      {variant === 'horizontal' && (
        <span class="mt-1 text-[0.6875rem] font-semibold tracking-[0.28em] uppercase opacity-80">
          Roofing
        </span>
      )}
    </span>
  )}
</span>
