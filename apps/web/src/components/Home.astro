---
import { Mail, Phone } from '@lucide/astro';
import { Picture } from 'astro:assets';
import clayStucco from '../assets/proyectos/teja-barro-estuco.jpg';
import clayDetail from '../assets/proyectos/teja-barro-detalle.jpg';
import metalHome from '../assets/proyectos/techo-metal-casa-blanca.jpg';
import palmModern from '../assets/proyectos/casa-palmeras-miami.jpg';
import shingleAerial from '../assets/proyectos/teja-asfaltica-vista-aerea.jpg';
import orlandoHome from '../assets/proyectos/casa-orlando.jpg';
import flatModern from '../assets/proyectos/techo-plano-casa-moderna.jpg';
import flatBuilding from '../assets/proyectos/techo-plano-edificio.jpg';
import crew from '../assets/proyectos/cuadrilla-instalando-teja.jpg';
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import Cine from './Cine.astro';
import RoofSection from './RoofSection.astro';
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const w = t.web;

const projects = [
  { key: 'clayStucco', img: clayStucco },
  { key: 'metalHome', img: metalHome },
  { key: 'shingleAerial', img: shingleAerial },
  { key: 'palmModern', img: palmModern },
  { key: 'flatModern', img: flatModern },
  { key: 'clayDetail', img: clayDetail },
  { key: 'orlandoHome', img: orlandoHome },
  { key: 'flatBuilding', img: flatBuilding },
  { key: 'crew', img: crew },
] as const;
const btnPrimary =
  'inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-primary px-8 font-display text-lg font-semibold text-primary-fg no-underline shadow-md transition-colors hover:bg-primary-hover';
---

<Base locale={locale}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/cine/m/f001.webp"
    media="(max-aspect-ratio: 9/10)"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/cine/d/f001.webp"
    media="(min-aspect-ratio: 9/10)"
  />

  <Cine locale={locale} />

  <div class="cine-after" data-cine-after>
    <!-- Visualizador de techos -->
    <RoofSection locale={locale} />

    <!-- Proyectos (fotos de stock de demostración) -->
    <section
      id="proyectos"
      class="scroll-mt-20 py-20 text-white sm:py-28"
      aria-labelledby="proyectos-title"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl" data-fade>
          <h2 id="proyectos-title" class="cine-after-title">
            {w.projects.title}
          </h2>
          <p class="mt-4 text-lg text-on-brand-muted">{w.projects.intro}</p>
        </div>
        <ul class="gallery mt-12">
          {projects.map(({ key, img }, i) => (
            <li class:list={['gallery-item', [0, 5, 8].includes(i) && 'gallery-wide']} data-fade>
              <Picture
                src={img}
                alt={w.projects.items[key].alt}
                formats={['avif', 'webp']}
                widths={[480, 720, 960, 1280]}
                sizes={
                  [0, 5, 8].includes(i)
                    ? '(min-width: 1024px) 720px, 100vw'
                    : '(min-width: 1024px) 360px, 100vw'
                }
                loading="lazy"
                decoding="async"
                class="size-full object-cover"
              />
              <div class="gallery-cap">
                <p class="gallery-tag">{w.projects.stockNote}</p>
                <h3>{w.projects.items[key].title}</h3>
                <p>{w.projects.items[key].text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contacto -->
    <section
      id="contacto"
      class="cine-form scroll-mt-20 py-20 text-white sm:py-28"
      aria-labelledby="contacto-title"
    >
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 id="contacto-title" class="cine-after-title" data-fade>
          {w.contact.title}
        </h2>
        <p class="mt-4 text-lg text-on-brand-muted" data-fade>
          {w.contact.text}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4" data-fade>
          <a href={`tel:${t.common.phoneHref}`} class={btnPrimary}>
            <Phone aria-hidden="true" class="size-5" />
            {t.common.phone}
          </a>
          <a
            href={`mailto:${t.common.email}`}
            class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full border border-white/70 px-8 font-display text-lg font-semibold text-on-brand no-underline hover:bg-white/15"
          >
            <Mail aria-hidden="true" class="size-5" />
            {t.common.email}
          </a>
        </div>
        <p class="mt-6 text-on-brand-muted" data-fade>
          {w.contact.hours}
        </p>
        <ContactForm locale={locale} />
        <p class="mt-10 text-sm text-on-brand-muted">{w.cine.videoCredit}</p>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .cine-after {
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 14px rgb(5 9 14 / 0.5);
  }
  .cine-after-title {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    color: #fff;
  }
  /* El formulario se apoya en el fondo oscuro: se reasignan los tokens en este ámbito. */
  .cine-form {
    --fg: #ffffff;
    --fg-muted: #cbd5e1;
    --surface: rgb(255 255 255 / 0.1);
    --border-strong: #cbd5e1;
    --ring: #f4b27a;
    --success: #86efac;
    --danger: #fca5a5;
    --success-soft: #0f3d24;
    --danger-soft: #4a1717;
  }
  html[data-cine='on'] [data-fade] {
    opacity: 0;
    transform: translateY(40px);
  }
  /* Galería: mosaico de fotos sin marcos; el pie se lee sobre un degradado en la propia foto. */
  .gallery {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  .gallery-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 0.25rem;
    isolation: isolate;
  }
  .gallery-item picture,
  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gallery-item img {
    transition: transform 900ms var(--ease-standard);
  }
  .gallery-item:hover img {
    transform: scale(1.05);
  }
  .gallery-cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 3.5rem 1.1rem 1rem;
    color: #fff;
    background: linear-gradient(to top, rgb(5 9 14 / 0.85), rgb(5 9 14 / 0));
  }
  .gallery-cap h3 {
    margin: 0.1rem 0 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
  }
  .gallery-cap p {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: #e2e8f0;
  }
  .gallery-cap .gallery-tag {
    margin: 0;
    font-family: var(--ff-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-brand-accent);
  }
  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery-wide {
      grid-column: span 2;
      aspect-ratio: 16 / 7;
    }
  }
  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
    .gallery-wide {
      grid-column: span 2;
      aspect-ratio: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-item img {
      transition: none;
    }
    .gallery-item:hover img {
      transform: none;
    }
  }
</style>
