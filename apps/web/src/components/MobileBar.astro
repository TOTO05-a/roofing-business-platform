---
import { Phone } from '@lucide/astro';
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
---

<div
  role="region"
  data-mobile-bar
  aria-label={t.web.mobileBar.label}
  class="on-brand fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-white/15 bg-surface-brand p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] sm:hidden"
>
  <a
    href={`tel:${t.common.phoneHref}`}
    class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-md border-2 border-white/50 font-display font-semibold text-on-brand no-underline"
  >
    <Phone aria-hidden="true" class="size-5" />
    {t.web.header.call}
  </a>
  <a
    href={`/${locale}/#contacto`}
    class="inline-flex min-h-12 flex-[1.6] items-center justify-center rounded-md bg-primary font-display font-semibold text-primary-fg no-underline"
  >
    {t.web.header.cta}
  </a>
</div>
