---
import { languageNames, locales, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={`/${l}/`} />
    ))}
  </head>
  <body>
    <a class="skip" href="#contenido">
      {t.skip}
    </a>
    <header>
      <nav aria-label={t.language}>
        <ul>
          {locales.map((l) => (
            <li>
              <a
                href={`/${l}/`}
                lang={l}
                hreflang={l}
                aria-current={l === locale ? 'page' : undefined}
              >
                {languageNames[l]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    margin: 0 auto;
    padding: 1rem;
    max-width: 40rem;
    line-height: 1.5;
  }
  ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  a[aria-current='page'] {
    font-weight: 700;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 1rem;
  }
</style>
