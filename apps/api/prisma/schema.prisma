// Esquema de identidad y acceso (Etapa 2), alineado con docs/arquitectura/modelo-datos.md §2.1.
// Los perfiles CustomerProfile/EmployeeProfile (y el enlace de la invitación con ellos) llegan
// en la siguiente etapa.
// Los modelos User, Session, Account, Verification y TwoFactor siguen el esquema que
// espera Better Auth (núcleo + plugin twoFactor). Los nombres de modelo y campo son los
// que usa el adaptador de Prisma; las tablas y columnas se mapean a snake_case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  // Siempre en minúsculas (CHECK en la migración); Better Auth también lo normaliza.
  email            String     @unique
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Borrado lógico: un usuario con deleted_at no puede iniciar sesión.
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  invitationsSent    Invitation[] @relation("InvitationInvitedBy")
  invitationAccepted Invitation?  @relation("InvitationAcceptedUser")
  auditLogs          AuditLog[]

  // Listado paginado de usuarios (filtrado opcional por rol, más recientes primero).
  @@index([role, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Hash scrypt de la contraseña (solo cuentas con providerId = "credential").
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

// Plugin twoFactor de Better Auth: el secreto TOTP y los códigos de respaldo se guardan
// cifrados con BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  // Bloqueo por intentos fallidos de verificación (accountLockout del plugin).
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sin índice en `secret`: va cifrado y Better Auth busca por userId.
  @@index([userId])
  @@map("two_factors")
}

// Invitaciones: único camino de registro. El token en claro solo viaja en el correo;
// aquí se guarda su SHA-256.
// En SQL (migración) además: CHECK de correo en minúsculas y el índice único parcial
// `invitations_email_pending_key` (una sola invitación pendiente —sin aceptar ni revocar— por correo).
model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  email          String
  role           Role
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedById    String?   @map("invited_by_id") @db.Uuid
  acceptedUserId String?   @unique @map("accepted_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy    User? @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUser User? @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([invitedById])
  @@map("invitations")
}

// Registro de auditoría (solo se inserta; nunca se actualiza ni se borra desde la app).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Nulo para acciones del sistema (seed, webhooks) o si el actor se anonimiza.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  // Copia del correo del actor en el momento de la acción (se conserva aunque cambie).
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  // Estado anterior y posterior de lo que cambió (nunca contraseñas, tokens ni secretos).
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
