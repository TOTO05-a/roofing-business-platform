// Esquema de identidad, acceso y perfiles (Etapa 2) y del CRM (propiedades, leads, citas,
// inspecciones y archivos), según docs/arquitectura/modelo-datos.md §2.1–2.3 y §4.
// La seguridad por fila (RLS), los roles de base de datos y las restricciones que Prisma no
// expresa viven en las migraciones (ver prisma/sql/).
// Los modelos User, Session, Account, Verification y TwoFactor siguen el esquema que
// espera Better Auth (núcleo + plugin twoFactor). Los nombres de modelo y campo son los
// que usa el adaptador de Prisma; las tablas y columnas se mapean a snake_case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EmployeeJobType {
  SALES
  INSPECTOR
  CREW_LEAD
}

enum ContactMethod {
  EMAIL
  PHONE
  SMS
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  name             String
  // Siempre en minúsculas (CHECK en la migración); Better Auth también lo normaliza.
  email            String     @unique
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Borrado lógico: un usuario con deleted_at no puede iniciar sesión.
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  invitationsSent    Invitation[]     @relation("InvitationInvitedBy")
  invitationAccepted Invitation?      @relation("InvitationAcceptedUser")
  auditLogs          AuditLog[]
  customerProfile    CustomerProfile?
  employeeProfile    EmployeeProfile?
  filesUploaded      File[]

  // Listado paginado de usuarios (filtrado opcional por rol, más recientes primero).
  @@index([role, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Hash scrypt de la contraseña (solo cuentas con providerId = "credential").
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

// Plugin twoFactor de Better Auth: el secreto TOTP y los códigos de respaldo se guardan
// cifrados con BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  // Bloqueo por intentos fallidos de verificación (accountLockout del plugin).
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sin índice en `secret`: va cifrado y Better Auth busca por userId.
  @@index([userId])
  @@map("two_factors")
}

// Invitaciones: único camino de registro. El token en claro solo viaja en el correo;
// aquí se guarda su SHA-256.
// En SQL (migración) además:
// - CHECK de correo en minúsculas;
// - índice único parcial `invitations_email_pending_key` (una pendiente por correo);
// - CHECK por rol: CUSTOMER exige customer_id; EMPLOYEE exige job types y, una vez aceptada,
//   employee_id (el EmployeeProfile se crea al aceptar porque su user_id es obligatorio).
model Invitation {
  id               String            @id @default(uuid(7)) @db.Uuid
  email            String
  role             Role
  tokenHash        String            @unique @map("token_hash")
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(3)
  invitedById      String?           @map("invited_by_id") @db.Uuid
  acceptedUserId   String?           @unique @map("accepted_user_id") @db.Uuid
  // Perfil destino: el cliente ya existe al invitar; el empleado se crea al aceptar.
  customerId       String?           @map("customer_id") @db.Uuid
  employeeId       String?           @map("employee_id") @db.Uuid
  // Tipos de trabajo con los que se creará el EmployeeProfile (solo invitaciones EMPLOYEE).
  employeeJobTypes EmployeeJobType[] @map("employee_job_types")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy    User?            @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUser User?            @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee     EmployeeProfile? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([invitedById])
  @@index([customerId])
  @@index([employeeId])
  @@map("invitations")
}

// Registro de auditoría: solo inserción. Un trigger (migración) rechaza UPDATE y DELETE.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Nulo para acciones del sistema (seed, webhooks) o si el actor se anonimiza.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  // Copia del correo del actor en el momento de la acción (se conserva aunque cambie).
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  // Estado anterior y posterior de lo que cambió (nunca contraseñas, tokens ni secretos).
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Cliente: nace como contacto sin cuenta (user_id nulo) y se enlaza al aceptar su invitación.
// En SQL además: CHECK de correo en minúsculas, CHECK de teléfono E.164 y el índice único
// parcial `customer_profiles_email_active_key` sobre lower(email) WHERE deleted_at IS NULL.
model CustomerProfile {
  id               String         @id @default(uuid(7)) @db.Uuid
  userId           String?        @unique @map("user_id") @db.Uuid
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  email            String?
  phone            String?
  preferredContact ContactMethod? @map("preferred_contact")
  marketingOptIn   Boolean        @default(false) @map("marketing_opt_in")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitations  Invitation[]
  properties   Property[]
  leads        Lead[]
  appointments Appointment[]

  @@index([lastName, firstName])
  @@map("customer_profiles")
}

// Empleado: siempre tiene cuenta. Puede tener varios tipos de trabajo (vende e inspecciona).
// En SQL además: CHECK de al menos un tipo de trabajo y CHECK de teléfono E.164.
model EmployeeProfile {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @unique @map("user_id") @db.Uuid
  jobTypes  EmployeeJobType[] @map("job_types")
  phone     String?
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?         @map("deleted_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitations   Invitation[]
  leadsAssigned Lead[]
  appointments  Appointment[]
  inspections   Inspection[]

  @@map("employee_profiles")
}

// Límite de intentos de login por cuenta (además del de por IP de Better Auth). Clave: correo
// normalizado, exista o no la cuenta, para no revelar cuáles existen.
model LoginThrottle {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("login_throttles")
}

// ---------------------------------------------------------------------------------------
// CRM: propiedades, leads, citas, inspecciones y archivos (modelo de datos §2.2, §2.3 y §3).
// Las máquinas de estados viven en los servicios de la API; aquí solo los valores posibles.
// ---------------------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SET
  INSPECTED
  QUOTED
  WON
  LOST
  SPAM
  DUPLICATE
}

enum LeadSource {
  WEB_FORM
  PHONE
  REFERRAL
  DOOR_KNOCK
  OTHER
}

enum AppointmentType {
  INSPECTION
  FOLLOW_UP
  ESTIMATE_PRESENTATION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
  RESCHEDULED
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum RoofType {
  ASPHALT_SHINGLE
  METAL
  CLAY_TILE
  CONCRETE_TILE
  FLAT
  OTHER
}

enum FileStatus {
  PENDING
  READY
  DELETED
}

// Propiedad (vivienda) de un cliente. En SQL además: CHECK de estado de EE. UU., ZIP, año de
// construcción y coordenadas.
model Property {
  id           String    @id @default(uuid(7)) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String
  state        String    @db.Char(2)
  zip          String
  lat          Decimal?  @db.Decimal(9, 6)
  lng          Decimal?  @db.Decimal(9, 6)
  yearBuilt    Int?      @map("year_built")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  leads        Lead[]
  appointments Appointment[]
  inspections  Inspection[]

  // Destino de las claves compuestas (propiedad, cliente): una cita o un lead solo pueden
  // apuntar a una propiedad del mismo cliente.
  @@unique([id, customerId])
  @@index([customerId])
  @@map("properties")
}

// Lead: contacto en bruto. Al convertirse se enlaza (o crea) un CustomerProfile y una Property.
// En SQL además: CHECK de contacto (correo o teléfono), correo en minúsculas, teléfono E.164,
// motivo obligatorio en LOST y cliente y propiedad obligatorios desde APPOINTMENT_SET.
model Lead {
  id           String     @id @default(uuid(7)) @db.Uuid
  status       LeadStatus @default(NEW)
  source       LeadSource
  sourceDetail String?    @map("source_detail")
  firstName    String     @map("first_name")
  lastName     String?    @map("last_name")
  email        String?
  phone        String?
  addressLine1 String?    @map("address_line1")
  addressLine2 String?    @map("address_line2")
  city         String?
  state        String?    @db.Char(2)
  zip          String?
  message      String?
  utm          Json?
  // Motivo por el que el filtro anti-spam marcó el envío (campo trampa, tiempo, límite…).
  spamReason   String?    @map("spam_reason")
  assignedToId String?    @map("assigned_to_id") @db.Uuid
  customerId   String?    @map("customer_id") @db.Uuid
  propertyId   String?    @map("property_id") @db.Uuid
  lostReason   String?    @map("lost_reason")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  assignedTo   EmployeeProfile? @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property     Property?        @relation(fields: [propertyId, customerId], references: [id, customerId], onDelete: Restrict)
  appointments Appointment[]

  @@index([status, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([propertyId, customerId])
  // Límite de envíos del formulario por correo y búsqueda de duplicados.
  @@index([email, createdAt(sort: Desc)])
  @@map("leads")
}

// Cita con un empleado asignado. En SQL además: CHECK ends_at > starts_at (máx. 12 h) y la
// restricción EXCLUDE appointments_no_overlap (btree_gist), que impide citas solapadas del
// mismo empleado en estados activos (SCHEDULED, CONFIRMED, IN_PROGRESS).
model Appointment {
  id                String            @id @default(uuid(7)) @db.Uuid
  propertyId        String            @map("property_id") @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  leadId            String?           @map("lead_id") @db.Uuid
  assigneeId        String            @map("assignee_id") @db.Uuid
  type              AppointmentType
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  status            AppointmentStatus @default(SCHEDULED)
  cancelReason      String?           @map("cancel_reason")
  notes             String?
  // Al reprogramar se crea una cita nueva que apunta a la anterior (que queda RESCHEDULED).
  rescheduledFromId String?           @unique @map("rescheduled_from_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)

  property        Property        @relation(fields: [propertyId, customerId], references: [id, customerId], onDelete: Restrict)
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  assignee        EmployeeProfile @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  rescheduledFrom Appointment?    @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo   Appointment?    @relation("AppointmentReschedule")
  inspection      Inspection?

  // Destino de la clave compuesta (cita, propiedad) de Inspection.
  @@unique([id, propertyId])
  @@index([assigneeId, startsAt])
  @@index([status, startsAt])
  @@index([customerId, startsAt])
  @@index([propertyId, customerId])
  @@index([leadId])
  @@map("appointments")
}

// Inspección de una cita (una por cita). En SQL además: CHECK completed_at ⇔ COMPLETED y edad
// del techo.
model Inspection {
  id            String           @id @default(uuid(7)) @db.Uuid
  appointmentId String           @unique @map("appointment_id") @db.Uuid
  propertyId    String           @map("property_id") @db.Uuid
  inspectorId   String           @map("inspector_id") @db.Uuid
  status        InspectionStatus @default(DRAFT)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(3)
  roofType      RoofType?        @map("roof_type")
  roofAgeYears  Int?             @map("roof_age_years")
  findings      String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(3)

  appointment Appointment         @relation(fields: [appointmentId, propertyId], references: [id, propertyId], onDelete: Restrict)
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  inspector   EmployeeProfile     @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
  sections    InspectionSection[]
  photos      InspectionPhoto[]

  @@unique([appointmentId, propertyId])
  @@index([inspectorId, status])
  @@index([propertyId])
  @@map("inspections")
}

// Medidas por sección del techo (área en planta en ft², pendiente rise/12 y longitudes en ft).
// En SQL además: CHECK de área > 0, pendiente 0..24 y longitudes >= 0.
model InspectionSection {
  id           String   @id @default(uuid(7)) @db.Uuid
  inspectionId String   @map("inspection_id") @db.Uuid
  name         String
  areaSqft     Decimal  @map("area_sqft") @db.Decimal(10, 2)
  pitchRise    Decimal  @map("pitch_rise") @db.Decimal(4, 1)
  ridgeFt      Decimal  @default(0) @map("ridge_ft") @db.Decimal(8, 2)
  eaveFt       Decimal  @default(0) @map("eave_ft") @db.Decimal(8, 2)
  hipFt        Decimal  @default(0) @map("hip_ft") @db.Decimal(8, 2)
  valleyFt     Decimal  @default(0) @map("valley_ft") @db.Decimal(8, 2)
  gutterFt     Decimal  @default(0) @map("gutter_ft") @db.Decimal(8, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inspection Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photos     InspectionPhoto[]

  @@index([inspectionId, sortOrder])
  @@map("inspection_sections")
}

// Puente tipado entre una inspección (y opcionalmente una de sus secciones) y su archivo.
// En SQL además: un trigger exige que la sección pertenezca a la misma inspección.
model InspectionPhoto {
  id           String    @id @default(uuid(7)) @db.Uuid
  inspectionId String    @map("inspection_id") @db.Uuid
  sectionId    String?   @map("section_id") @db.Uuid
  fileId       String    @unique @map("file_id") @db.Uuid
  caption      String?
  takenAt      DateTime? @map("taken_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  inspection Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  section    InspectionSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  file       File               @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([inspectionId])
  @@index([sectionId])
  @@map("inspection_photos")
}

// Metadatos de un objeto del almacenamiento S3 (bucket privado). Los bytes nunca pasan por aquí.
// En SQL además: CHECK de sha256 en hex, tamaño (1 B a 25 MB) y tipos MIME permitidos.
model File {
  id           String     @id @default(uuid(7)) @db.Uuid
  bucket       String
  objectKey    String     @map("object_key")
  mimeType     String     @map("mime_type")
  sizeBytes    BigInt     @map("size_bytes")
  sha256       String     @db.Char(64)
  originalName String?    @map("original_name")
  uploadedById String?    @map("uploaded_by_id") @db.Uuid
  status       FileStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  inspectionPhoto InspectionPhoto?

  @@unique([bucket, objectKey])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("files")
}
