# Copia este archivo a .env (no se versiona). Valores solo para desarrollo local.
# Obligatorio (development, test o production).
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d postgres).
# DATABASE_URL es el DUEÑO de las tablas: solo lo usan las migraciones (db:deploy), db:roles y el
# seed. La API nunca se conecta con él (seguridad por fila, decisión T25).
DATABASE_URL=postgresql://roofing:roofing_dev_password@localhost:5432/roofing
# Roles de la API, creados por la migración de RLS sin LOGIN. `pnpm --filter @roofing/api db:roles`
# les pone estas contraseñas (16+ caracteres de [A-Za-z0-9_-]). Valores solo para local.
APP_DB_PASSWORD=app_user_dev_password
SYSTEM_DB_PASSWORD=app_system_dev_password
# app_user: peticiones de personas autenticadas (con contexto RLS por transacción).
APP_DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:5432/roofing
# app_system: Better Auth, invitaciones, límite de intentos y formulario público.
SYSTEM_DATABASE_URL=postgresql://app_system:app_system_dev_password@localhost:5432/roofing
# Base de datos de las pruebas de integración (se crea y migra sola al correrlas).
TEST_DATABASE_URL=postgresql://roofing:roofing_dev_password@localhost:5432/roofing_test

# Better Auth. Genera un secreto propio con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-caracteres
# URL pública con la que el navegador llega a /api (la app hace de proxy en desarrollo).
BETTER_AUTH_URL=http://localhost:5173
# Origen de la app React (enlaces de los correos y origen de confianza para CSRF).
APP_URL=http://localhost:5173
# Orígenes extra de confianza, separados por comas (opcional).
TRUSTED_ORIGINS=
APP_NAME=Roofing Platform
# Proxies de confianza delante de la API: 0 en local, 1 en Render.
TRUST_PROXY=0

# Correo: Mailpit en desarrollo (bandeja en http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Roofing Platform <no-reply@roofing.local>

# Horas de validez de una invitación (72 = 3 días).
INVITATION_TTL_HOURS=72

# Fotos y archivos (decisiones T28 y T29): Garage, compatible con S3, en docker compose.
#   docker compose up -d garage   y luego   pnpm --filter @roofing/api storage:init
# Valores de ejemplo SOLO locales (la clave la crea storage:init con estos mismos valores).
# Sin S3_ENDPOINT y claves, las rutas de fotos responden 503 y el resto de la API funciona.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=roofing-files
S3_ACCESS_KEY_ID=GK0a1b2c3d4e5f60718293a4b5
S3_SECRET_ACCESS_KEY=5e1d7c3b9a2f4e6d8c0b1a3f5e7d9c2b4a6f8e0d1c3b5a7f9e2d4c6b8a0f1e3d
S3_FORCE_PATH_STYLE=true

# Formulario público del sitio (Astro, puerto 4321): orígenes que pueden enviarlo, separados
# por comas. En producción deben ser https.
PUBLIC_FORM_ORIGINS=http://localhost:4321
# Antispam: envíos por IP cada 15 min y por correo o teléfono cada 24 h (opcional).
PUBLIC_FORM_IP_LIMIT=10
PUBLIC_FORM_CONTACT_LIMIT=3

# Seed de desarrollo (pnpm --filter @roofing/api db:seed). Elige tus propios valores;
# la contraseña necesita al menos 12 caracteres. El seed se niega a correr en producción.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Superadministrador

# Usuarios y datos de demostración (opcional). Con SEED_DEMO=true el seed crea además clientes,
# propiedades, leads, citas e inspección ficticios del Sur de Florida, y un usuario por rol:
#   cliente@, empleado@, administrador@ y superadmin@ cresta-roofing.example.
# Pon una contraseña de al menos 12 caracteres a cada una. Valores de PRUEBA sugeridos
# (solo local; nunca los uses en un entorno real):
#   SEED_DEMO_CUSTOMER_PASSWORD=Demo-Cliente-2026
#   SEED_DEMO_EMPLOYEE_PASSWORD=Demo-Empleado-2026
#   SEED_DEMO_ADMIN_PASSWORD=Demo-Admin-2026!
#   SEED_DEMO_SUPERADMIN_PASSWORD=Demo-Superadmin-2026
# El administrador y el superadministrador demo NO tienen el 2FA desactivado: al iniciar sesión
# por primera vez la app obliga a activarlo; escanea el QR con una app TOTP (o usa el secreto
# mostrado con cualquier generador TOTP) y confirma el código de 6 dígitos.
SEED_DEMO=false
SEED_DEMO_CUSTOMER_PASSWORD=
SEED_DEMO_EMPLOYEE_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=
SEED_DEMO_SUPERADMIN_PASSWORD=
