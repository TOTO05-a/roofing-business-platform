# Copia este archivo a .env (no se versiona). Valores solo para desarrollo local.
# Obligatorio (development, test o production).
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d postgres). Prisma lee también este valor.
DATABASE_URL=postgresql://roofing:roofing_dev_password@localhost:5432/roofing
# Base de datos de las pruebas de integración (se crea y migra sola al correrlas).
TEST_DATABASE_URL=postgresql://roofing:roofing_dev_password@localhost:5432/roofing_test

# Better Auth. Genera un secreto propio con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-caracteres
# URL pública con la que el navegador llega a /api (la app hace de proxy en desarrollo).
BETTER_AUTH_URL=http://localhost:5173
# Origen de la app React (enlaces de los correos y origen de confianza para CSRF).
APP_URL=http://localhost:5173
# Orígenes extra de confianza, separados por comas (opcional).
TRUSTED_ORIGINS=
APP_NAME=Roofing Platform
# Proxies de confianza delante de la API: 0 en local, 1 en Render.
TRUST_PROXY=0

# Correo: Mailpit en desarrollo (bandeja en http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Roofing Platform <no-reply@roofing.local>

# Horas de validez de una invitación (72 = 3 días).
INVITATION_TTL_HOURS=72

# Seed de desarrollo (pnpm --filter @roofing/api db:seed). Elige tus propios valores;
# la contraseña necesita al menos 12 caracteres. El seed se niega a correr en producción.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Superadministrador
